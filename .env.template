# ==============================================================================
# Konfigurace prostředí pro aplikaci Hlídač parkoviště
# ==============================================================================
# Zkopírujte tento soubor jako `.env` a případně upravte hodnoty:
#   Windows (PowerShell): Copy-Item .env.template .env
#   Linux/macOS:          cp .env.template .env
# ==============================================================================

# --- Databáze (PostgreSQL) ---
# Tyto proměnné využívá Docker Compose i backend (api.py / main.py)
DB_NAME=parkoviste_db
DB_USER=postgres
DB_PASSWORD=tajne_heslo
DB_HOST=db

# Pro cloudové nasazení (např. Railway) lze zadat celou URL k databázi.
# Pokud je DATABASE_URL vyplněna, má přednost před DB_HOST/DB_NAME/DB_USER/DB_PASSWORD.
# Pro lokální docker nechte zakomentované / prázdné:
# DATABASE_URL=postgresql://postgres:tajne_heslo@db:5432/parkoviste_db

# --- Nastavení workeru a detekce (main.py) ---
# Interval stahování a vyhodnocování snímků z webkamery v sekundách (výchozí: 300 = 5 minut)
INTERVAL_SEKUNDY=300

# Doba uchování archivovaných snímků ve dnech (starší snímky se promazávají)
RETENTION_DAYS=7

# Parametry AI modelu YOLOv8
YOLO_CONF=0.25
YOLO_IOU=0.7
IMGSZ=1280

# --- Webový server ---
PORT=8000

# --- Parkovací zóny a kompenzace posunu kamery (např. větrem) ---
# Globální posun všech zón v pixelech (změny se uplatní okamžitě při dalším snímku i bez restartu):
# ZONE_OFFSET_X: kladné = posun doprava (+px), záporné = posun doleva (-px)
# ZONE_OFFSET_Y: kladné = posun dolů (+px), záporné = posun nahoru (-px)
ZONE_OFFSET_X=0
ZONE_OFFSET_Y=0

# Cesta k JSON souboru se souřadnicemi zón (výchozí: parking_zones.json)
PARKING_ZONES_FILE=parking_zones.json

# Alternativně lze zóny zadat přímo jako JSON string v ENV (má přednost před souborem):
# PARKING_ZONES_JSON=[[[434, 499], [524, 556], [35, 925], [30, 740]], [[700, 533], [850, 559], [950, 1020], [670, 1020]], [[470, 360], [550, 359], [1, 700], [3, 600]]]
